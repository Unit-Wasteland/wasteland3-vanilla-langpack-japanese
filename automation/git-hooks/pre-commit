#!/bin/bash
#
# Pre-commit hook: Action Marker Validation
#
# Prevents commits containing action markers translated to Japanese
# Added: 2025-11-02 (Prevention measure for Session 7 error)
#
# Installation:
#   cp automation/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

TARGET_FILE="translation/target/v1.6.9.420.309496/ja_JP/StringTableData_English-CAB-83ff0546f42d84e747fefe7ae7126de0--1617434765046421955.txt"

echo "🔍 Running pre-commit validation..."

# Check if target file is staged
if git diff --cached --name-only | grep -q "$TARGET_FILE"; then
    echo "  → Validating action markers in: $TARGET_FILE"

    # Check for Japanese characters in action markers
    JAPANESE_IN_ACTIONS=$(grep -o '::[^:]*[ぁ-ゖァ-ヾ一-龯][^:]*::' "$TARGET_FILE" 2>/dev/null)

    if [ -n "$JAPANESE_IN_ACTIONS" ]; then
        echo ""
        echo "❌ ERROR: Action markers contain Japanese characters!"
        echo ""
        echo "Found the following action markers with Japanese:"
        echo "$JAPANESE_IN_ACTIONS" | head -10
        if [ $(echo "$JAPANESE_IN_ACTIONS" | wc -l) -gt 10 ]; then
            echo "  ... and $(( $(echo "$JAPANESE_IN_ACTIONS" | wc -l) - 10 )) more"
        fi
        echo ""
        echo "Action markers MUST remain in English. Please fix before committing."
        echo ""
        echo "To find the exact lines, run:"
        echo "  grep -n '::[^:]*[ぁ-ゖァ-ヾ一-龯][^:]*::' $TARGET_FILE"
        echo ""
        exit 1
    fi

    echo "  ✅ Action marker validation passed"
else
    echo "  → Target file not staged, skipping validation"
fi

echo "✅ Pre-commit validation passed"
exit 0
